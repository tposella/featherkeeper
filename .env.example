# Featherkeeper settings. Copy this file to .env and fill it in.
# Never commit your .env: it holds passwords and API keys.

# ---- Site --------------------------------------------------------------------
# The address people use to reach the site. Start with the LXC's own address while
# testing on your network, then change it to your https:// domain once nginx and the
# tunnel are set up. An https:// address turns on secure cookies, which only work over HTTPS.
PUBLIC_URL=http://192.168.1.50:8080
# Port the web container listens on, on the host.
WEB_PORT=8080
# Let anyone create an account. The first account on a new site always becomes the admin.
ALLOW_REGISTRATION=true
# Optional: create the admin account on first start instead of registering in the browser.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ---- Database ----------------------------------------------------------------
POSTGRES_USER=featherkeeper
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=featherkeeper

# ---- Photos ------------------------------------------------------------------
# Where photos are stored. Empty = a Docker volume. Or a host folder, e.g. a Proxmox
# mount point: PHOTOS_DIR=/mnt/photos (run: chown 1000:1000 /mnt/photos).
PHOTOS_DIR=
# Largest photo upload, in MB (0 = no limit). Cloudflare's free plan rejects requests over
# 100 MB, so keep 100 if you use a Cloudflare Tunnel. Reverse proxies must allow a little more.
MAX_UPLOAD_MB=100

# ---- eBird (species import) --------------------------------------------------
# Free key: https://ebird.org/api/keygen. Leave empty to switch eBird import off.
EBIRD_API_KEY=

# ---- Place search ------------------------------------------------------------
# Finds towns for "birds around a place". Defaults to OpenStreetMap's public Nominatim.
# Point it at your own Nominatim server, or set it empty to switch place search off.
# GEOCODER_URL=https://nominatim.openstreetmap.org

# ---- AI photo identification (optional) -------------------------------------
# Suggests the top species for a photo, weighted by what eBird has recorded near where
# it was taken. To turn on the bundled BioCLIP 2 model (needs about 4 GB of RAM):
#   COMPOSE_PROFILES=ai
#   IDENTIFY_PROVIDER=bioclip
# then run: docker compose up -d --build. The first start downloads the model (about 1.7 GB).
COMPOSE_PROFILES=
IDENTIFY_PROVIDER=none
# Smaller, faster, less accurate model for low-memory machines (about 1.5 GB of RAM):
# IDENTIFIER_MODEL=hf-hub:imageomics/bioclip
# Limit CPU threads the model may use (default: all cores).
# IDENTIFIER_THREADS=4
# For IDENTIFY_PROVIDER=http (your own service; see docs/ai-identification.md):
IDENTIFY_URL=
IDENTIFY_API_KEY=
